                    sock.close()
                    return {"port": port, "service": name}
            self.data["http"] = None
    def scan_ports(self):
        critical_ports = {21: "FTP", 22: "SSH", 80: "HTTP", 443: "HTTPS", 3306: "MySQL", 3389: "RDP", 8080: "HTTP-Alt"}

