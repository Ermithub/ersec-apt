#!/usr/bin/env python3
import concurrent.futures
import json
import os
import socket
import sys
import requests
from rich.console import Console
from rich.panel import Panel
from rich.progress import Progress, SpinnerColumn, TextColumn
from rich.table import Table

console = Console()

class ErsecEngine:
    def __init__(self, target):
        self.target = target.replace("https://", "").replace("http://", "").strip("/")
        self.ip = None
        self.ips = []
        self.risk_score = 0.0
        self.risk_factors = []
        self.data = {}

    def resolve_dns(self):
        try:
            _, _, ips = socket.gethostbyname_ex(self.target)
            self.ips = ips
            self.ip = ips[0]
            self.data["ips"] = ips
        except Exception as e:
            console.print(f"[bold red][!] DNS Resolution failed for {self.target}: {e}[/bold red]")
            sys.exit(1)

    def fetch_geoip(self):
        try:
            res = requests.get(f"http://ip-api.com/json/{self.ip}?fields=status,country,regionName,city,isp,org,as,query", timeout=5).json()
            self.data["geoip"] = res if res.get("status") == "success" else None
        except Exception:
            self.data["geoip"] = None

    def audit_http_headers(self):
        headers_info = {"present": {}, "missing": []}
        try:
            res = requests.get(f"http://{self.target}", timeout=6, allow_redirects=True)
            headers = res.headers
            sec_headers = {
                "Strict-Transport-Security": "HSTS Enforced",
                "Content-Security-Policy": "CSP Configured",
                "X-Frame-Options": "Clickjacking Protection",
                "X-Content-Type-Options": "MIME Sniffing Protection"
            }
            for header, label in sec_headers.items():
                if header in headers:
                    headers_info["present"][label] = headers[header][:30]
                else:
                    headers_info["missing"].append(label)
                    self.risk_score += 0.6
                    self.risk_factors.append(f"Missing Header: {header}")
            self.data["http"] = headers_info
        except Exception:
            self.data["http"] = None

    def scan_ports(self):
        critical_ports = {
            21: "FTP", 22: "SSH", 80: "HTTP", 443: "HTTPS", 
            3306: "MySQL", 3389: "RDP", 6379: "Redis", 8080: "HTTP-Alt"
        }
        open_services = []

        def probe(port, name):
            try:
                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock.settimeout(1.0)
                if sock.connect_ex((self.ip, port)) == 0:
                    sock.close()
                    return {"port": port, "service": name}
                sock.close()
            except Exception:
                pass
            return None

        with concurrent.futures.ThreadPoolExecutor(max_workers=10) as executor:
            futures = [executor.submit(probe, p, s) for p, s in critical_ports.items()]
            for f in concurrent.futures.as_completed(futures):
                res = f.result()
                if res:
                    open_services.append(res)
                    if res["port"] in [21, 3306, 3389, 6379]:
                        self.risk_score += 2.5
                        self.risk_factors.append(f"High-Risk Exposed Port: {res['service']} ({res['port']})")
                    else:
                        self.risk_score += 0.5

        self.data["ports"] = open_services

    def generate_ethical_hacking_vectors(self):
        """Generates advanced MITRE-aligned adversary simulation vectors if risk score >= 4.0."""
        vectors = []
        score = min(self.risk_score, 10.0)
        
        if score >= 4.0:
            vectors.append({
                "category": "Vector 1: Application Layer & Vulnerability Probing",
                "mitre": "MITRE ATT&CK T1190 (Exploit Public-Facing Application)",
                "action": "Conduct authorized vulnerability assessments or protocol fuzzing against exposed service ports to verify input sanitization and patch levels."
            })
            vectors.append({
                "category": "Vector 2: Volumetric Load & Denial-of-Service Resilience",
                "mitre": "MITRE ATT&CK T1498 (Network Denial of Service / Stress Simulation)",
                "action": "Execute controlled concurrency benchmarking and edge rate-limiting validation tests to measure resilience against volumetric saturation."
            })
            vectors.append({
                "category": "Vector 3: Credential Access & Brute-Force Testing",
                "mitre": "MITRE ATT&CK T1110 (Brute Force / Credential Stuffing)",
                "action": "Simulate automated login/dictionary evaluations against active authentication interfaces to verify account lockout enforcement and password complexity."
            })
        return vectors

    def query_ai_engine(self):
        """Universal AI client with updated 2026 production endpoints."""
        api_key = os.getenv("GROQ_API_KEY") or os.getenv("AI_API_KEY")
        if not api_key:
            return "[yellow]API key environment variable not detected. Skipping AI executive assessment.[/yellow]"

        # Updated current model IDs
        candidate_models = [
            "openai/gpt-oss-120b",
            "openai/gpt-oss-20b",
            "qwen/qwen3-32b"
        ]

        prompt = f"""
        Target Scope: {self.target}
        Calculated Risk Score: {self.risk_score}/10
        Identified Vulnerabilities: {json.dumps(self.risk_factors)}
        Open Ports Discovered: {json.dumps(self.data.get('ports', []))}

        Act as an elite CISO Red Team Analyst. Provide:
        1. Concise Executive Threat Summary.
        2. Primary Adversary Exploit Chain.
        3. Strategic Hardening Recommendations.
        """

        headers = {"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"}
        
        for model in candidate_models:
            try:
                res = requests.post(
                    "https://api.groq.com/openai/v1/chat/completions",
                    headers=headers,
                    json={"model": model, "messages": [{"role": "user", "content": prompt}], "temperature": 0.2},
                    timeout=8
                )
                if res.status_code == 200:
                    return res.json()['choices'][0]['message']['content']
            except Exception:
                continue

        return "[red]AI endpoints unreachable or rate-limited. Operating on core static telemetry engine.[/red]"

    def run_all(self):
        console.print(Panel.fit(
            f"[bold white style=on red] ERSEC v8.0 — PROFESSIONAL ENTERPRISE SECURITY PLATFORM [/]\n"
            f"[bold cyan]Target Scope:[/] {self.target}",
            border_style="red"
        ))

        self.resolve_dns()

        with Progress(SpinnerColumn(), TextColumn("[progress.description]{task.description}"), transient=True) as progress:
            progress.add_task(description="Executing Deep Telemetry & Attack Surface Audit...", total=None)
            with concurrent.futures.ThreadPoolExecutor() as executor:
                executor.submit(self.fetch_geoip)
                executor.submit(self.audit_http_headers)
                executor.submit(self.scan_ports)

        final_score = round(min(self.risk_score, 10.0), 1)
        score_color = "red" if final_score >= 4.0 else "green"
        console.print(Panel(f"ATTACK SURFACE RISK SCORE: {final_score} / 10.0", border_style=score_color))

        # Conditional Ethical Hacking / Adversary Simulation Vectors (Triggered if score >= 4.0)
        if final_score >= 4.0:
            vectors = self.generate_ethical_hacking_vectors()
            table_vec = Table(title="[bold red]Authorized Ethical Hacking & Adversary Simulation Vectors (MITRE Aligned)[/bold red]", expand=True)
            table_vec.add_column("Simulation Vector", style="cyan", width=25)
            table_vec.add_column("MITRE Framework", style="yellow", width=25)
            table_vec.add_column("Authorized Operator Actions", style="white")

            for v in vectors:
                table_vec.add_row(v["category"], v["mitre"], v["action"])
            console.print(table_vec)
            console.print("[bold yellow]LEGAL DISCLAIMER:[/bold yellow] [dim]These simulation pathways are provided strictly for authorized penetration testing and defensive posture validation under explicit written authorization. 100% legal and operational accountability rests exclusively upon the system operator.[/dim]\n")

        # Professional AI Intelligence Output
        ai_output = self.query_ai_engine()
        console.print(Panel(ai_output, title="[bold cyan]AI Executive Threat Intelligence Analysis[/bold cyan]", border_style="cyan"))

if __name__ == "__main__":
    if len(sys.argv) < 3 or sys.argv[1] != "scan":
        console.print("[bold red]Usage Error:[/bold red] ersec scan <domain.com>")
        sys.exit(1)
    engine = ErsecEngine(sys.argv[2])
    engine.run_all()
