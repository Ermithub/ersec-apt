#!/usr/bin/env python3
"""
ersec - Enterprise Security Recon & Evaluation (Read-Only Reconnaissance Engine)
Refactored: professional, modular, type-hinted, read-only vulnerability reconnaissance.

Features implemented:
 - Rich, enterprise-grade --help menu using rich Panels and Text
 - Deep passive and active (non-exploitative) auditing: DNS enumeration, TLS/SSL checks, HTTP header validation, port scanning, service banner grabbing
 - Mapping of discovered misconfigurations to MITRE ATT&CK technique IDs (best-effort suggestions) with operator disclaimer
 - Final polished Rich Table with columns: Finding/Misconfiguration, Severity, MITRE Tactic, MITRE Technique ID, Remediation
 - Modular code, graceful timeout handling, no exploitation payloads

Usage:
  ersec --targets example.com,192.0.2.1 [--threads 30] [--timeout 3] [--output-json out.json]

Operator Disclaimer: defensive use only. Obtain written authorization before scanning targets you do not own.
"""

from __future__ import annotations

import argparse
import concurrent.futures
import json
import logging
import os
import re
import socket
import ssl
import sys
import time
from dataclasses import dataclass, asdict, field
from datetime import datetime
from typing import Dict, List, Optional, Tuple

import requests
from requests.exceptions import RequestException
from rich import box
from rich.console import Console
from rich.panel import Panel
from rich.progress import Progress, SpinnerColumn, TextColumn, BarColumn, TimeElapsedColumn
from rich.table import Table
from rich.text import Text

# Optional dnspython support for richer DNS enumeration; fall back if not installed
try:
    import dns.resolver  # type: ignore
    DNSPYTHON_AVAILABLE = True
except Exception:
    DNSPYTHON_AVAILABLE = False

# Logging
logger = logging.getLogger("ersec")
logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")

console = Console()

# Critical ports and service hints
CRITICAL_PORTS: Dict[str, int] = {
    "FTP": 21,
    "SSH": 22,
    "HTTP": 80,
    "HTTPS": 443,
    "MySQL": 3306,
    "RDP": 3389,
    "Redis": 6379,
}

# MITRE mapping helper: best-effort suggested mappings
MITRE_MAP: Dict[str, Tuple[str, str]] = {
    # finding -> (tactic, technique)
    "weak_tls_protocol": ("Initial Access / Exfiltration", "T1190"),  # Exploit Public-Facing Application
    "weak_cipher": ("Initial Access", "T1190"),
    "expired_certificate": ("Initial Access", "T1190"),
    "missing_hsts": ("Initial Access", "T1190"),
    "missing_csp": ("Initial Access", "T1190"),
    "missing_xframe": ("Defense Evasion", "T1190"),
    "server_header_disclosure": ("Discovery", "T1595"),
    "open_remote_service": ("Lateral Movement / Remote Services", "T1021"),
    "service_version_disclosure": ("Discovery", "T1595"),
}

# Severity ordering
SEVERITY_ORDER = ("Low", "Medium", "High", "Critical")

@dataclass
class Finding:
    finding: str
    severity: str
    mitre_tactic: str
    mitre_technique: str
    remediation: str
    # New optional CVE enrichment fields
    cve_id: Optional[str] = None
    cvss: Optional[str] = None
    cve_desc: Optional[str] = None


def render_help_panel(parser: argparse.ArgumentParser) -> None:
    """Render a polished rich help panel replacing default argparse help."""
    header = Text("ersec — Enterprise Security Recon & Evaluation", style="bold white on blue")
    subtitle = Text("Read-only vulnerability reconnaissance engine — defensive use only", style="bold yellow")

    body = Text()
    body.append("Usage:\n", style="bold underline")
    body.append("  ")
    body.append("ersec --targets example.com,192.0.2.1 [options]\n\n")

    body.append("Deep analysis performed by --targets:\n", style="bold")
    body.append("  • DNS enumeration (A, AAAA, MX, NS, TXT, CNAME)\n")
    body.append("  • TLS/SSL analysis (protocol, cipher, certificate validity)\n")
    body.append("  • Comprehensive HTTP security header validation (HSTS, CSP, X-Frame-Options, X-Content-Type-Options, Referrer-Policy, Permissions-Policy)\n")
    body.append("  • Open port scanning (critical services) and service banner grabbing\n")
    body.append("  • Mapping findings to suggested MITRE ATT&CK techniques for defensive prioritization\n\n")

    body.append("Important: This tool is strictly non-exploitative. It will NOT run active exploitation payloads. Obtain written authorization before running against systems you do not own.\n")

    panel = Panel.fit(Text.assemble(header, "\n", subtitle, "\n\n", body), title="ersec — Help & Overview", border_style="bright_blue")
    console.print(panel)

    # Print argparse auto help for flags quickly
    console.print("Options:")
    parser.print_help()


# Utilities

def is_ip_address(value: str) -> bool:
    try:
        socket.inet_pton(socket.AF_INET, value)
        return True
    except OSError:
        try:
            socket.inet_pton(socket.AF_INET6, value)
            return True
        except OSError:
            return False


def resolve_dns_all(name: str, timeout: float = 3.0) -> Dict[str, List[str]]:
    """Resolve common DNS record types. Uses dnspython if available, otherwise falls back to basic getaddrinfo for A/AAAA."""
    out: Dict[str, List[str]] = {"A": [], "AAAA": [], "MX": [], "NS": [], "TXT": [], "CNAME": []}
    try:
        if DNSPYTHON_AVAILABLE:
            resolver = dns.resolver.Resolver()
            resolver.lifetime = timeout
            for qtype in ("A", "AAAA", "MX", "NS", "TXT", "CNAME"):
                try:
                    answers = resolver.resolve(name, qtype)
                    for r in answers:
                        out[qtype].append(str(r).rstrip("."))
                except Exception:
                    continue
        else:
            # Best-effort A/AAAA using getaddrinfo
            try:
                infos = socket.getaddrinfo(name, None)
                for item in infos:
                    ip = item[4][0]
                    if ":" in ip:
                        out["AAAA"].append(ip)
                    else:
                        out["A"].append(ip)
                # Deduplicate
                out["A"] = sorted(set(out["A"]))
                out["AAAA"] = sorted(set(out["AAAA"]))
            except Exception:
                pass
    except Exception as e:
        logger.debug("DNS enumeration error for %s: %s", name, e)
    return out


def tcp_banner_grab(host: str, port: int, timeout: float = 3.0) -> Optional[str]:
    """Attempt to read a service banner from host:port. Non-intrusive: opens TCP connection and reads first bytes."""
    try:
        with socket.create_connection((host, port), timeout=timeout) as s:
            s.settimeout(timeout)
            # For HTTP, send a minimal request to elicit headers
            if port in (80, 443):
                try:
                    req = f"HEAD / HTTP/1.1\r\nHost: {host}\r\nConnection: close\r\n\r\n"
                    s.sendall(req.encode("utf-8", errors="ignore"))
                except Exception:
                    pass
            try:
                data = s.recv(4096)
                if not data:
                    return None
                # decode safely
                try:
                    return data.decode("utf-8", errors="replace").strip()
                except Exception:
                    return repr(data)
            except Exception:
                return None
    except (socket.timeout, ConnectionRefusedError) as e:
        logger.debug("Banner grab timeout/refused %s:%s - %s", host, port, e)
        return None
    except Exception as e:
        logger.debug("Unexpected banner grab error %s:%s - %s", host, port, e)
        return None


def tls_inspect(host: str, port: int = 443, timeout: float = 5.0) -> Dict[str, Optional[str]]:
    """Perform TLS handshake and return protocol, cipher, cert validity info. Non-invasive."""
    info: Dict[str, Optional[str]] = {"protocol": None, "cipher": None, "cert_subject": None, "cert_issuer": None, "cert_expiry": None, "cert_valid": None}
    context = ssl.create_default_context()
    # Do not verify host cert for inspection purposes, but still read it
    context.check_hostname = False
    context.verify_mode = ssl.CERT_NONE
    try:
        with socket.create_connection((host, port), timeout=timeout) as sock:
            with context.wrap_socket(sock, server_hostname=host) as ssock:
                proto = ssock.version()
                cipher = ssock.cipher()
                info["protocol"] = proto
                info["cipher"] = cipher[0] if cipher else None
                try:
                    cert = ssock.getpeercert()
                    if cert:
                        subj = cert.get("subject")
                        issuer = cert.get("issuer")
                        notAfter = cert.get("notAfter")
                        info["cert_subject"] = str(subj)
                        info["cert_issuer"] = str(issuer)
                        info["cert_expiry"] = notAfter
                        # parse expiry
                        try:
                            expiry_dt = datetime.strptime(notAfter, "%b %d %H:%M:%S %Y %Z")
                        except Exception:
                            try:
                                expiry_dt = datetime.strptime(notAfter, "%Y%m%d%H%M%SZ")
                            except Exception:
                                expiry_dt = None
                        if expiry_dt:
                            info["cert_valid"] = "expired" if expiry_dt < datetime.utcnow() else "valid"
                        else:
                            info["cert_valid"] = "unknown"
                except Exception:
                    logger.debug("Failed to parse peer cert for %s:%s", host, port)
    except Exception as e:
        logger.debug("TLS inspect failed for %s:%s - %s", host, port, e)
    return info


def http_header_audit(url: str, timeout: float = 5.0) -> Dict[str, Optional[str]]:
    """Fetch HTTP headers and evaluate security headers. Non-destructive."""
    headers = {}
    try:
        r = requests.head(url, timeout=timeout, allow_redirects=True)
        hdrs = r.headers or {}
        if not hdrs or r.status_code >= 400:
            r = requests.get(url, timeout=timeout, allow_redirects=True)
            hdrs = r.headers or {}
    except RequestException as e:
        logger.debug("HTTP header fetch failed for %s: %s", url, e)
        return {"error": str(e)}

    # Evaluate headers
    checks: Dict[str, Optional[str]] = {}
    # HSTS
    hsts = hdrs.get("Strict-Transport-Security")
    if hsts:
        checks["hsts"] = None
    else:
        checks["hsts"] = "missing"
    # CSP
    csp = hdrs.get("Content-Security-Policy")
    checks["csp"] = None if csp else "missing"
    # X-Frame-Options
    xfo = hdrs.get("X-Frame-Options")
    checks["xframe"] = None if xfo else "missing"
    # X-Content-Type-Options
    xcto = hdrs.get("X-Content-Type-Options")
    checks["xcontenttype"] = None if xcto else "missing"
    # Referrer-Policy
    ref = hdrs.get("Referrer-Policy")
    checks["referrer"] = None if ref else "missing"
    # Permissions-Policy / Feature-Policy
    perm = hdrs.get("Permissions-Policy") or hdrs.get("Feature-Policy")
    checks["permissions"] = None if perm else "missing"
    # Server header disclosure
    server = hdrs.get("Server")
    checks["server"] = server or None

    checks["raw_headers"] = dict(hdrs)
    return checks


def map_finding_to_mitre(key: str) -> Tuple[str, str]:
    """Return (tactic, technique) mapping or default placeholders. Use MITRE_MAP best-effort mappings."""
    if key in MITRE_MAP:
        return MITRE_MAP[key]
    # default fallback
    return ("Discovery", "T1595")


def extract_version_candidates(banners: Dict[str, Optional[str]], raw_headers: Dict[str, str]) -> List[Tuple[str, str]]:
    """Extract (product, version) candidates from banners and Server headers using heuristics."""
    candidates: List[Tuple[str, str]] = []
    rx = re.compile(r"([A-Za-z0-9\-_+.]+)[/ ]([0-9]+(?:\.[0-9]+){0,2})")
    # From banners
    for port, banner in banners.items():
        if not banner:
            continue
        # search first line
        first_line = banner.splitlines()[0]
        for m in rx.finditer(first_line):
            prod = m.group(1)
            ver = m.group(2)
            candidates.append((prod, ver))
    # From Server header
    server = raw_headers.get("Server") if raw_headers else None
    if server:
        for m in rx.finditer(server):
            candidates.append((m.group(1), m.group(2)))
    # From other headers (e.g., X-Powered-By)
    for _, v in (raw_headers or {}).items():
        if not isinstance(v, str):
            continue
        for m in rx.finditer(v):
            candidates.append((m.group(1), m.group(2)))
    # Deduplicate preserving order
    seen = set()
    out: List[Tuple[str, str]] = []
    for p, v in candidates:
        key = f"{p}:{v}".lower()
        if key not in seen:
            seen.add(key)
            out.append((p, v))
    return out


def query_nvd_for_keyword(keyword: str, api_key: Optional[str] = None, results_per_page: int = 5, timeout: float = 8.0) -> List[Dict[str, str]]:
    """Query NVD JSON API v2.0 for a keyword and return a list of simplified CVE dicts.
    This function is read-only and only performs safe API queries.
    """
    base = "https://services.nvd.nist.gov/rest/json/cves/2.0"
    headers = {}
    if api_key:
        headers["API-Key"] = api_key
    params = {"keyword": keyword, "resultsPerPage": results_per_page}
    try:
        r = requests.get(base, params=params, headers=headers, timeout=timeout)
        r.raise_for_status()
        data = r.json()
        vulns = data.get("vulnerabilities") or []
        out = []
        for v in vulns:
            cve = v.get("cve") or {}
            cve_id = cve.get("id")
            descriptions = cve.get("descriptions") or []
            desc = ""
            for d in descriptions:
                if d.get("lang") == "en":
                    desc = d.get("value")
                    break
            # Extract CVSS if present (v3 preferred)
            cvss_val = None
            metrics = v.get("cveMetrics") or v.get("metrics") or {}
            # v2.0 response may include 'metrics' with cvssMetricV3
            try:
                # Try multiple locations safely
                cvss3 = None
                if isinstance(metrics, dict):
                    # search for known keys
                    if "cvssMetricV31" in metrics and metrics["cvssMetricV31"]:
                        cvss3 = metrics["cvssMetricV31"][0].get("cvssData", {}).get("baseSeverity")
                    elif "cvssMetricV30" in metrics and metrics["cvssMetricV30"]:
                        cvss3 = metrics["cvssMetricV30"][0].get("cvssData", {}).get("baseSeverity")
                # Fallback to searching inside cve object
                if not cvss3:
                    # many responses include 'score' structures; try to find v3 vector
                    # This is best-effort and tolerant of schema differences
                    if isinstance(cve.get("metrics"), dict):
                        m = cve.get("metrics")
                        if m.get("cvssMetricV31"):
                            cvss3 = m["cvssMetricV31"][0].get("cvssData", {}).get("baseSeverity")
                        elif m.get("cvssMetricV30"):
                            cvss3 = m["cvssMetricV30"][0].get("cvssData", {}).get("baseSeverity")
                cvss_val = cvss3
            except Exception:
                cvss_val = None
            out.append({"cve_id": cve_id, "cvss": cvss_val or "N/A", "description": desc or ""})
        return out
    except Exception as e:
        logger.debug("NVD query failed for %s: %s", keyword, e)
        return []


def enrich_findings_with_cves(findings: List[Finding], version_candidates: List[Tuple[str, str]], nvd_api_key: Optional[str] = None) -> None:
    """For findings that mention service version disclosure, query NVD for matching product+version keywords and enrich the Finding objects in-place.

    This keeps behaviour read-only: only queries public NVD API.
    """
    if not version_candidates:
        return
    # Build searchable keywords: product and product+version
    keywords = []
    for prod, ver in version_candidates:
        keywords.append(prod)
        keywords.append(f"{prod} {ver}")
        keywords.append(f"{prod}/{ver}")
    # de-duplicate
    keywords = list(dict.fromkeys(keywords))

    # Query NVD for each keyword until we find something useful
    nvd_cache: Dict[str, List[Dict[str, str]]] = {}
    for kw in keywords:
        nvd_cache[kw] = query_nvd_for_keyword(kw, api_key=nvd_api_key)

    # For each finding that looks like a version disclosure, attach the most relevant CVE (first with a CVE id)
    for f in findings:
        if "reveals" in f.finding.lower() or "version" in f.finding.lower() or "disclosure" in f.finding.lower():
            # find best match in cache
            selected = None
            for kw, vulns in nvd_cache.items():
                if not vulns:
                    continue
                # pick first vuln with id
                for v in vulns:
                    if v.get("cve_id"):
                        selected = v
                        break
                if selected:
                    break
            if selected:
                f.cve_id = selected.get("cve_id")
                f.cvss = selected.get("cvss")
                f.cve_desc = (selected.get("description") or "").strip()


def assess_findings_for_target(target: str, resolved_ips: List[str], open_ports: Dict[str, int], tls_info: Dict[str, Optional[str]], header_checks: Dict[str, Optional[str]], banners: Dict[str, Optional[str]]) -> List[Finding]:
    findings: List[Finding] = []

    # TLS findings
    proto = tls_info.get("protocol")
    cipher = tls_info.get("cipher")
    cert_valid = tls_info.get("cert_valid")
    if proto and proto.upper() not in ("TLSV1.2", "TLSV1.3"):
        tactic, tech = map_finding_to_mitre("weak_tls_protocol")
        findings.append(Finding(
            finding=f"Weak TLS protocol: {proto}",
            severity="High",
            mitre_tactic=tactic,
            mitre_technique=tech,
            remediation="Disable legacy TLS versions (TLS 1.0/1.1) and enable TLS 1.2+; enforce strong server-side configuration.",
        ))
    # weak cipher heuristics
    weak_keywords = ("RC4", "DES", "3DES", "NULL", "EXPORT")
    if cipher and any(k.lower() in (cipher or "").lower() for k in weak_keywords):
        tactic, tech = map_finding_to_mitre("weak_cipher")
        findings.append(Finding(
            finding=f"Weak TLS cipher in use: {cipher}",
            severity="Medium",
            mitre_tactic=tactic,
            mitre_technique=tech,
            remediation="Remove weak ciphers from server configuration and prefer AEAD ciphers like AES-GCM and ChaCha20-Poly1305.",
        ))
    if cert_valid == "expired":
        tactic, tech = map_finding_to_mitre("expired_certificate")
        findings.append(Finding(
            finding="TLS certificate expired",
            severity="High",
            mitre_tactic=tactic,
            mitre_technique=tech,
            remediation="Replace certificate with a valid certificate and ensure automated renewal (e.g., via ACME/LetsEncrypt) is configured.",
        ))

    # Header findings
    if header_checks:
        if header_checks.get("hsts") == "missing":
            tactic, tech = map_finding_to_mitre("missing_hsts")
            findings.append(Finding(
                finding="Missing Strict-Transport-Security header (HSTS)",
                severity="Medium",
                mitre_tactic=tactic,
                mitre_technique=tech,
                remediation="Add Strict-Transport-Security: max-age=31536000; includeSubDomains; preload after validation.",
            ))
        if header_checks.get("csp") == "missing":
            tactic, tech = map_finding_to_mitre("missing_csp")
            findings.append(Finding(
                finding="Missing Content-Security-Policy header (CSP)",
                severity="Medium",
                mitre_tactic=tactic,
                mitre_technique=tech,
                remediation="Implement a restrictive Content-Security-Policy; start with reporting-only mode to evaluate impact.",
            ))
        if header_checks.get("xframe") == "missing":
            tactic, tech = map_finding_to_mitre("missing_xframe")
            findings.append(Finding(
                finding="Missing X-Frame-Options header",
                severity="Low",
                mitre_tactic=tactic,
                mitre_technique=tech,
                remediation="Add X-Frame-Options: DENY or SAMEORIGIN or use CSP frame-ancestors directive.",
            ))
        if header_checks.get("xcontenttype") == "missing":
            findings.append(Finding(
                finding="Missing X-Content-Type-Options header",
                severity="Low",
                mitre_tactic="Defense Evasion",
                mitre_technique="T1595",
                remediation="Add X-Content-Type-Options: nosniff to prevent MIME type sniffing.",
            ))
        if header_checks.get("server"):
            tactic, tech = map_finding_to_mitre("server_header_disclosure")
            findings.append(Finding(
                finding=f"Server header disclosure: {header_checks.get('server')}",
                severity="Low",
                mitre_tactic=tactic,
                mitre_technique=tech,
                remediation="Remove or obfuscate Server header; avoid exposing software versions to public requests.",
            ))

    # Open ports and banners
    for svc, port in open_ports.items():
        tactic, tech = map_finding_to_mitre("open_remote_service")
        rem = f"If service {svc} is unnecessary, stop and disable it. Otherwise, restrict access via firewall/VPC and require MFA where applicable."
        findings.append(Finding(
            finding=f"Open service port: {svc} ({port})",
            severity="Medium" if svc not in ("RDP", "MySQL") else "High",
            mitre_tactic=tactic,
            mitre_technique=tech,
            remediation=rem,
        ))
        banner = banners.get(str(port))
        if banner:
            # include only first line snippet
            first_line = banner.splitlines()[0][:200]
            findings.append(Finding(
                finding=f"Service banner on {svc}:{port} reveals: {first_line}",
                severity="Low",
                mitre_tactic=map_finding_to_mitre("service_version_disclosure")[0],
                mitre_technique=map_finding_to_mitre("service_version_disclosure")[1],
                remediation="Avoid exposing version strings in banners; configure services to limit informational responses.",
            ))

    return findings


def analyze_target(target: str, threads: int, timeout: float, nvd_api_key: Optional[str] = None, shodan_key: Optional[str] = None, censys_key: Optional[str] = None) -> Dict[str, object]:
    """Run read-only reconnaissance and return structured results including Findings."""
    start = time.time()
    resolved = []
    dns_info = {}
    if is_ip_address(target):
        resolved = [target]
    else:
        # Resolve basic A/AAAA
        try:
            infos = socket.getaddrinfo(target, None)
            resolved = sorted({item[4][0] for item in infos})
        except Exception:
            resolved = []
        dns_info = resolve_dns_all(target, timeout=timeout)

    # Port scan (limited set) and banner grabbing
    open_ports: Dict[str, int] = {}
    banners: Dict[str, Optional[str]] = {}

    def check_port(svc_port: Tuple[str, int]) -> Tuple[str, int, bool]:
        svc, port = svc_port
        ips = resolved or [target]
        # check first reachable IP
        for ip in ips:
            try:
                with socket.create_connection((ip, port), timeout=timeout) as s:
                    s.close()
                    return svc, port, True
            except Exception:
                continue
        return svc, port, False

    with concurrent.futures.ThreadPoolExecutor(max_workers=max(2, threads)) as pool:
        futures = {pool.submit(check_port, item): item for item in CRITICAL_PORTS.items()}
        for fut in concurrent.futures.as_completed(futures):
            svc, port = futures[fut]
            try:
                svc, port, is_open = fut.result()
                if is_open:
                    open_ports[svc] = port
            except Exception as e:
                logger.debug("Error scanning %s:%s - %s", svc, port, e)

    # Banner grabbing for open ports
    for svc, port in open_ports.items():
        ip = (resolved[0] if resolved else target)
        banner = tcp_banner_grab(ip, port, timeout=timeout)
        banners[str(port)] = banner

    # TLS inspection if HTTPS detected or port 443 open
    tls_info = {}
    if "HTTPS" in open_ports or 443 in open_ports.values():
        try:
            tls_info = tls_inspect(target if not is_ip_address(target) else resolved[0], port=443, timeout=timeout)
        except Exception as e:
            logger.debug("TLS inspect exception: %s", e)
            tls_info = {}
    else:
        tls_info = {}

    # HTTP header audit if HTTP/HTTPS available
    header_checks = {}
    if "HTTP" in open_ports or "HTTPS" in open_ports:
        scheme = "https" if "HTTPS" in open_ports else "http"
        url = f"{scheme}://{target}"
        header_checks = http_header_audit(url, timeout=timeout)

    # Version candidates (from banners and headers)
    version_candidates = extract_version_candidates(banners, header_checks.get("raw_headers") or {})

    findings = assess_findings_for_target(target, resolved, open_ports, tls_info, header_checks, banners)

    # Enrich findings with NVD/CVE info for version-related disclosures (read-only)
    try:
        enrich_findings_with_cves(findings, version_candidates, nvd_api_key=nvd_api_key)
    except Exception as e:
        logger.debug("CVE enrichment failed: %s", e)

    result = {
        "target": target,
        "resolved_ips": resolved,
        "dns": dns_info,
        "open_ports": open_ports,
        "banners": banners,
        "tls": tls_info,
        "headers": header_checks,
        "version_candidates": version_candidates,
        "findings": [asdict(f) for f in findings],
        "elapsed": time.time() - start,
    }
    return result


def render_findings_table(all_findings: List[Tuple[str, Finding]]):
    """Render Rich table with exact columns required."""
    table = Table(title="ersec Findings", box=box.SIMPLE_HEAVY)
    table.add_column("Target", style="cyan", no_wrap=True)
    table.add_column("Finding/Misconfiguration", style="magenta")
    table.add_column("Severity", style="red")
    table.add_column("MITRE Tactic", style="yellow")
    table.add_column("MITRE Technique ID", style="green")
    table.add_column("CVE ID", style="bright_blue")
    table.add_column("CVSS Severity", style="bright_red")
    table.add_column("CVE Description", style="white")
    table.add_column("Remediation", style="white")

    for target, f in all_findings:
        table.add_row(
            target,
            f.finding,
            f.severity,
            f.mitre_tactic,
            f.mitre_technique,
            f.cve_id or "",
            f.cvss or "",
            (f.cve_desc or "")[:120],
            f.remediation,
        )

    console.print(table)


def operator_disclaimer():
    txt = Text()
    txt.append("Operator Disclaimer\n", style="bold red")
    txt.append("This tool performs non-exploitative reconnaissance and provides defensive findings only. Do NOT run it against systems without explicit written authorization. The MITRE ATT&CK mappings are best-effort suggestions.\n", style="yellow")
    console.print(Panel(txt, title="Operator Disclaimer", border_style="red"))


def main(argv: Optional[List[str]] = None) -> int:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--targets", help="Comma-separated list of targets (hostnames or IPs)")
    parser.add_argument("--targets-file", help="File with newline-separated targets (comments with #)")
    parser.add_argument("--threads", type=int, default=20, help="Number of threads for scanning")
    parser.add_argument("--timeout", type=float, default=3.0, help="Network timeout seconds")
    parser.add_argument("--output-json", help="Write results to JSON file")
    parser.add_argument("--help", "-h", action="store_true", help="Show help and exit")
    # Optional passive intelligence connectors (read-only queries)
    parser.add_argument("--shodan-key", help="Optional Shodan API key for passive host enrichment (read-only)")
    parser.add_argument("--censys-key", help="Optional Censys API key for passive host enrichment (read-only)")
    parser.add_argument("--nvd-api-key", help="Optional NVD API key to increase NVD rate limits for CVE lookups")

    args = parser.parse_args(argv)

    if args.help:
        render_help_panel(parser)
        return 0

    targets: List[str] = []
    if args.targets:
        targets.extend([t.strip() for t in args.targets.split(",") if t.strip()])
    if args.targets_file:
        try:
            with open(args.targets_file, "r", encoding="utf8") as fh:
                for line in fh:
                    s = line.strip()
                    if not s or s.startswith("#"):
                        continue
                    targets.append(s)
        except Exception as e:
            console.print(f"[red]Failed to read targets file: {e}[/red]")
            return 2

    if not targets:
        console.print("[bold red]No targets specified. Use --targets or --targets-file. Use --help for detailed usage.[/bold red]")
        return 2

    console.print(Panel(Text("ersec — Enterprise Security Reconnaissance (Read-Only)\nDefensive, non-exploitative scanning only", justify="center"), border_style="blue"))
    operator_disclaimer()

    results = []
    findings_accum: List[Tuple[str, Finding]] = []

    with Progress(SpinnerColumn(), TextColumn("[progress.description]{task.description}"), BarColumn(), TimeElapsedColumn(), console=console) as progress:
        task = progress.add_task("Scanning targets...", total=len(targets))
        with concurrent.futures.ThreadPoolExecutor(max_workers=min(len(targets), max(2, args.threads))) as pool:
            future_map = {pool.submit(analyze_target, t, args.threads, args.timeout, args.nvd_api_key, args.shodan_key, args.censys_key): t for t in targets}
            for fut in concurrent.futures.as_completed(future_map):
                t = future_map[fut]
                try:
                    res = fut.result()
                    results.append(res)
                    # Extract findings
                    for fdict in res.get("findings", []):
                        # tolerate missing newer fields when loading from older JSON
                        fdict.setdefault("cve_id", None)
                        fdict.setdefault("cvss", None)
                        fdict.setdefault("cve_desc", None)
                        f = Finding(**fdict)
                        findings_accum.append((t, f))
                except Exception as e:
                    logger.exception("Error analyzing %s: %s", t, e)
                progress.update(task, advance=1)

    # Render findings table
    if findings_accum:
        render_findings_table(findings_accum)
    else:
        console.print(Panel(Text("No findings detected by current checks. Review results and consider enabling additional scanners or reviewing manually."), title="Summary", border_style="green"))

    # Optional JSON output
    if args.output_json:
        try:
            with open(args.output_json, "w", encoding="utf8") as fh:
                json.dump(results, fh, indent=2, ensure_ascii=False)
            console.print(f"[blue]Results written to {args.output_json}[/blue]")
        except Exception as e:
            logger.exception("Failed to write JSON: %s", e)
            console.print(f"[red]Failed to write JSON: {e}[/red]")

    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        console.print("\n[red]Interrupted by user[/red]")
        sys.exit(130)
