#!/usr/bin/env python3
import concurrent.futures
import json
import os
import socket
import sys
import requests
from rich.console import Console
from rich.panel import Panel
from rich.progress import Progress, SpinnerColumn, TextColumn
from rich.table import Table

console = Console()

class ErsecEngine:
    def __init__(self, target):
        self.target = target.replace("https://", "").replace("http://", "").strip("/")
        self.ip = None
        self.ips = []
        self.risk_score = 0.0
        self.risk_factors = []
        self.data = {}

    def resolve_dns(self):
        try:
            _, _, ips = socket.gethostbyname_ex(self.target)
            self.ips = ips
            self.ip = ips[0]
            self.data["ips"] = ips
        except Exception as e:
            console.print(f"[bold red][!] DNS Resolution failed for {self.target}: {e}[/bold red]")
            sys.exit(1)

    def fetch_geoip(self):
        try:
            res = requests.get(f"http://ip-api.com/json/{self.ip}?fields=status,country,regionName,city,isp,org,as,query", timeout=5).json()
            self.data["geoip"] = res if res.get("status") == "success" else None
        except Exception:
            self.data["geoip"] = None

    def audit_http_headers(self):
        headers_info = {"present": {}, "missing": []}
        try:
            res = requests.get(f"http://{self.target}", timeout=6, allow_redirects=True)
            headers = res.headers
            sec_headers = {
                "Strict-Transport-Security": "HSTS Enforced",
                "Content-Security-Policy": "CSP Configured",
                "X-Frame-Options": "Clickjacking Protection",
                "X-Content-Type-Options": "MIME Sniffing Protection"
            }
            for header, label in sec_headers.items():
                if header in headers:
                    headers_info["present"][label] = headers[header][:30]
                else:
                    headers_info["missing"].append(label)
                    self.risk_score += 0.6
                    self.risk_factors.append(f"Missing Header: {header}")
            self.data["http"] = headers_info
        except Exception:
            self.data["http"] = None

    def scan_ports(self):
        critical_ports = {
            21: "FTP", 22: "SSH", 80: "HTTP", 443: "HTTPS", 
            3306: "MySQL", 3389: "RDP", 6379: "Redis", 8080: "HTTP-Alt"
        }
        open_services = []

        def probe(port, name):
            try:
                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock.settimeout(1.0)
                if sock.connect_ex((self.ip, port)) == 0:
                    sock.close()
                    return {"port": port, "service": name}
                sock.close()
            except Exception:
                pass
            return None

        with concurrent.futures.ThreadPoolExecutor(max_workers=10) as executor:
            futures = [executor.submit(probe, p, s) for p, s in critical_ports.items()]
            for f in concurrent.futures.as_completed(futures):
                res = f.result()
                if res:
                    open_services.append(res)
                    if res["port"] in [21, 3306, 3389, 6379]:
                        self.risk_score += 2.5
                        self.risk_factors.append(f"High-Risk Exposed Port: {res['service']} ({res['port']})")
                    else:
                        self.risk_score += 0.5

        self.data["ports"] = open_services

    def generate_advanced_simulation_vectors(self):
        """Generates advanced MITRE-aligned attack vectors if risk score > 4.0 under strict operator responsibility."""
        vectors = []
        score = min(self.risk_score, 10.0)
        
        if score >= 4.0:
            vectors.append({
                "category": "Vector 1: Application & Public-Facing Exploitation",
                "mitre": "MITRE ATT&CK T1190 (Exploit Public-Facing Application)",
                "action": "Perform controlled vulnerability probing or exploit framework evaluations against identified database/service ports to test authentication robustness and input sanitization."
            })
            vectors.append({
                "category": "Vector 2: Volumetric Stress & Service Resilience",
                "mitre": "MITRE ATT&CK T1498 (Network Denial of Service / Stress Testing)",
                "action": "Execute authorized high-concurrency request benchmarking or SYN/HTTP flood resilience testing to measure edge rate-limiting thresholds and load balancer degradation points."
            })
            vectors.append({
                "category": "Vector 3: Credential Access & Brute-Force Simulation",
                "mitre": "MITRE ATT&CK T1110 (Brute Force / Credential Stuffing)",
                "action": "Simulate automated dictionary attacks against exposed remote administration services (e.g., SSH/RDP/MySQL) to audit lockout policies and password complexity enforcement."
            })
        return vectors

    def query_ai_engine(self):
        """Robust multi-model fallback API client labeled cleanly as AI."""
        api_key = os.getenv("GROQ_API_KEY") or os.getenv("AI_API_KEY")
        if not api_key:
            return "[yellow]API key environment variable not detected. Skipping generative AI threat matrix.[/yellow]"

        # Up-to-date models list with automatic error fallbacks
        candidate_models = [
            "openai/gpt-oss-120b",
            "llama-3.3-70b-versatile",
            "qwen/qwen3.6-27b",
            "llama-3.1-8b-instant"
        ]

        prompt = f"""
        Target Scope: {self.target}
        Calculated Risk Score: {self.risk_score}/10
        Identified Risk Factors: {json.dumps(self.risk_factors)}
        Open Ports Found: {json.dumps(self.data.get('ports', []))}

        Act as an elite CISO Red Team Analyst. Provide:
        1. Executive Threat Assessment (2 sentences).
        2. Primary Exploit Chain Pathway.
        3. Strategic Remediation Recommendation.
        """

        headers = {"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"}
        
        for model in candidate_models:
            try:
                res = requests.post(
                    "https://api.groq.com/openai/v1/chat/completions",
                    headers=headers,
                    json={"model": model, "messages": [{"role": "user", "content": prompt}], "temperature": 0.2},
                    timeout=8
                )
                if res.status_code == 200:
                    return res.json()['choices'][0]['message']['content']
            except Exception:
                continue

        return "[red]All AI endpoints currently unreachable or rate-limited. Proceeding with static analysis engine.[/red]"

    def run_all(self):
        console.print(Panel.fit(
            f"[bold white style=on red] ERSEC v6.0 — PROFESSIONAL ENTERPRISE SECURITY PLATFORM [/]\n"
            f"[bold cyan]Target Domain:[/] {self.target}",
            border_style="red"
        ))

        self.resolve_dns()

        with Progress(SpinnerColumn(), TextColumn("[progress.description]{task.description}"), transient=True) as progress:
            progress.add_task(description="Executing Deep Telemetry & Attack Surface Audit...", total=None)
            with concurrent.futures.ThreadPoolExecutor() as executor:
                executor.submit(self.fetch_geoip)
                executor.submit(self.audit_http_headers)
                executor.submit(self.scan_ports)

        final_score = round(min(self.risk_score, 10.0), 1)
        score_color = "red" if final_score >= 4.0 else "green"
        console.print(Panel(f"ATTACK SURFACE RISK SCORE: {final_score} / 10.0", border_style=score_color))

        # Ethical Red-Team Module (Triggered if score >= 4.0)
        if final_score >= 4.0:
            vectors = self.generate_advanced_simulation_vectors()
            table_vec = Table(title="[bold red]Authorized Adversary Simulation Vectors (MITRE ATT&CK Aligned)[/bold red]", expand=True)
            table_vec.add_column("Simulation Category", style="cyan", width=25)
            table_vec.add_column("MITRE Mapping", style="yellow", width=25)
            table_vec.add_column("Operator Action Specification", style="white")

            for v in vectors:
                table_vec.add_row(v["category"], v["mitre"], v["action"])
            console.print(table_vec)
            console.print("[bold yellow]DISCLAIMER:[/bold yellow] [dim]Execution of these simulation vectors is restricted exclusively to authorized systems under explicit written consent. 100% legal and operational liability rests solely upon the system operator.[/dim]\n")

        # Clean AI Intelligence Output
        ai_output = self.query_ai_engine()
        console.print(Panel(ai_output, title="[bold cyan]AI Executive Threat Intelligence Analysis[/bold cyan]", border_style="cyan"))

if __name__ == "__main__":
    if len(sys.argv) < 3 or sys.argv[1] != "scan":
        console.print("[bold red]Usage Error:[/bold red] ersec scan <domain.com>")
        sys.exit(1)
    engine = ErsecEngine(sys.argv[2])
    engine.run_all()
