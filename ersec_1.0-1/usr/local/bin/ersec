#!/usr/bin/env python3
import concurrent.futures
import json
import re
import socket
import ssl
import sys
import urllib.request
import requests
from rich.console import Console
from rich.panel import Panel
from rich.progress import Progress, SpinnerColumn, TextColumn
from rich.table import Table
from rich.tree import Tree

console = Console()

class ErsecEngine:
    def __init__(self, target):
        self.target = target.replace("https://", "").replace("http://", "").strip("/")
        self.ip = None
        self.ips = []
        self.risk_score = 0.0
        self.risk_factors = []
        self.data = {}

    def resolve_dns(self):
        """Resolves target IP addresses and primary DNS A records."""
        try:
            _, _, ips = socket.gethostbyname_ex(self.target)
            self.ips = ips
            self.ip = ips[0]
            self.data["ips"] = ips
        except Exception as e:
            console.print(f"[bold red][!] DNS Resolution failed for {self.target}: {e}[/bold red]")
            sys.exit(1)

    def fetch_geoip(self):
        """Fetches IP Geolocation, ISP, and ASN information."""
        try:
            res = requests.get(f"http://ip-api.com/json/{self.ip}?fields=status,country,regionName,city,isp,org,as,query", timeout=5).json()
            if res.get("status") == "success":
                self.data["geoip"] = res
            else:
                self.data["geoip"] = None
        except Exception:
            self.data["geoip"] = None

    def fetch_rdap_whois(self):
        """Queries RDAP protocol for WHOIS domain registration data."""
        try:
            res = requests.get(f"https://rdap.org/domain/{self.target}", timeout=6).json()
            events = {e.get("eventAction"): e.get("eventDate", "N/A")[:10] for e in res.get("events", [])}
            self.data["rdap"] = {
                "handle": res.get("handle", "N/A"),
                "registrar": res.get("port43", "N/A"),
                "created": events.get("registration", "N/A"),
                "expiration": events.get("expiration", "N/A"),
                "updated": events.get("last changed", "N/A"),
                "status": res.get("status", [])[:3]
            }
        except Exception:
            self.data["rdap"] = None

    def audit_http_headers(self):
        """Audits security headers, web server details, and cookies."""
        headers_info = {"present": {}, "missing": [], "server": "N/A", "cookies": []}
        try:
            res = requests.get(f"http://{self.target}", timeout=6, allow_redirects=True)
            headers = res.headers

            headers_info["server"] = headers.get("Server", "Hidden / Generic")
            headers_info["powered_by"] = headers.get("X-Powered-By", "Hidden")
            headers_info["status_code"] = res.status_code
~cat << 'EOF' > /usr/local/bin/ersec
#!/usr/bin/env python3
import concurrent.futures
import json
import re
import socket
import ssl
import sys
import urllib.request
import requests
from rich.console import Console
from rich.panel import Panel
from rich.progress import Progress, SpinnerColumn, TextColumn
from rich.table import Table
from rich.tree import Tree

console = Console()

class ErsecEngine:
    def __init__(self, target):
        self.target = target.replace("https://", "").replace("http://", "").strip("/")
        self.ip = None
        self.ips = []
        self.risk_score = 0.0
        self.risk_factors = []
        self.data = {}

    def resolve_dns(self):
        """Resolves target IP addresses and primary DNS A records."""
        try:
            _, _, ips = socket.gethostbyname_ex(self.target)
            self.ips = ips
            self.ip = ips[0]
            self.data["ips"] = ips
        except Exception as e:
            console.print(f"[bold red][!] DNS Resolution failed for {self.target}: {e}[/bold red]")
            sys.exit(1)

    def fetch_geoip(self):
        """Fetches IP Geolocation, ISP, and ASN information."""
        try:
            res = requests.get(f"http://ip-api.com/json/{self.ip}?fields=status,country,regionName,city,isp,org,as,query", timeout=5).json()
            if res.get("status") == "success":
                self.data["geoip"] = res
            else:
                self.data["geoip"] = None
        except Exception:
            self.data["geoip"] = None

    def fetch_rdap_whois(self):
        """Queries RDAP protocol for WHOIS domain registration data."""
        try:
            res = requests.get(f"https://rdap.org/domain/{self.target}", timeout=6).json()
            events = {e.get("eventAction"): e.get("eventDate", "N/A")[:10] for e in res.get("events", [])}
            self.data["rdap"] = {
                "handle": res.get("handle", "N/A"),
                "registrar": res.get("port43", "N/A"),
                "created": events.get("registration", "N/A"),
                "expiration": events.get("expiration", "N/A"),
                "updated": events.get("last changed", "N/A"),
                "status": res.get("status", [])[:3]
            }
        except Exception:
            self.data["rdap"] = None

    def audit_http_headers(self):
        """Audits security headers, web server details, and cookies."""
        headers_info = {"present": {}, "missing": [], "server": "N/A", "cookies": []}
        try:
            res = requests.get(f"http://{self.target}", timeout=6, allow_redirects=True)
            headers = res.headers

            headers_info["server"] = headers.get("Server", "Hidden / Generic")
            headers_info["powered_by"] = headers.get("X-Powered-By", "Hidden")
            headers_info["status_code"] = res.status_code

            # Critical Security Headers Audit
            sec_headers = {
                "Strict-Transport-Security": "HSTS Enforced",
                "Content-Security-Policy": "CSP Configured",
                "X-Frame-Options": "Clickjacking Protection",
                "X-Content-Type-Options": "MIME Sniffing Protection",
                "Referrer-Policy": "Referrer Policy Set",
                "Permissions-Policy": "Permissions Policy Set"
            }

            for header, label in sec_headers.items():
                if header in headers:
                    headers_info["present"][label] = headers[header][:40] + "..." if len(headers[header]) > 40 else headers[header]
                else:
                    headers_info["missing"].append(label)
                    self.risk_score += 0.5
                    self.risk_factors.append(f"Missing Security Header: {header}")

            self.data["http"] = headers_info
        except Exception:
            self.data["http"] = None

    def inspect_ssl_tls(self):
        """Inspects SSL/TLS Certificate, Expiry, and Subject Alternative Names (SANs)."""
        try:
            ctx = ssl.create_default_context()
            with ctx.wrap_socket(socket.socket(), server_hostname=self.target) as s:
                s.settimeout(5.0)
                s.connect((self.target, 443))
                cert = s.getpeercert()

                issuer = dict(x[0] for x in cert.get('issuer', []))
                subject = dict(x[0] for x in cert.get('subject', []))
                sans = [item[1] for item in cert.get('subjectAltName', []) if item[0] == 'DNS']

                self.data["ssl"] = {
                    "common_name": subject.get('commonName', self.target),
                    "issuer": issuer.get('organizationName', issuer.get('commonName', 'Unknown')),
                    "valid_until": cert.get('notAfter'),
                    "sans_count": len(sans),
                    "sans_sample": sans[:8]
                }
        except Exception as e:
            self.risk_score += 1.5
            self.risk_factors.append("SSL/TLS Configuration Error or Port 443 Closed")
            self.data["ssl"] = {"error": str(e)}

    def enumerate_subdomains(self):
        """Discovers subdomains via crt.sh Certificate Transparency logs."""
        subdomains = set()
        try:
            url = f"https://crt.sh/?q=%25.{self.target}&output=json"
            res = requests.get(url, timeout=8).json()
            for entry in res:
                name = entry.get('name_value', '').lower()
                for sub in name.split('\n'):
                    if not sub.startswith('*') and self.target in sub:
                        subdomains.add(sub)
            self.data["subdomains"] = sorted(list(subdomains))
        except Exception:
            self.data["subdomains"] = []

    def check_robots_txt(self):
        """Scrapes robots.txt for hidden paths and sensitive directories."""
        disallowed = []
        try:
            res = requests.get(f"http://{self.target}/robots.txt", timeout=5)
            if res.status_code == 200:
                lines = res.text.splitlines()
                for line in lines:
                    if line.strip().lower().startswith("disallow:"):
                        path = line.split(":", 1)[1].strip()
                        if path and path != "/":
                            disallowed.append(path)
                if disallowed:
                    self.risk_score += 0.5
                    self.risk_factors.append(f"Exposed paths in robots.txt ({len(disallowed)} endpoints)")
            self.data["robots"] = disallowed[:10]
        except Exception:
            self.data["robots"] = []

    def scan_ports_and_banners(self):
        """Scans top critical ports and grabs service response banners."""
        critical_ports = {
            21: "FTP", 22: "SSH", 23: "TELNET", 25: "SMTP", 53: "DNS",
            80: "HTTP", 110: "POP3", 143: "IMAP", 443: "HTTPS", 445: "SMB",
            1433: "MSSQL", 3306: "MySQL", 3389: "RDP", 5432: "PostgreSQL",
            6379: "Redis", 8080: "HTTP-Alt", 8443: "HTTPS-Alt", 27017: "MongoDB"
        }
        open_services = []

        def probe_port(port, service_name):
            try:
                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock.settimeout(1.2)
                res = sock.connect_ex((self.ip, port))
                if res == 0:
                    banner = ""
                    try:
                        sock.sendall(b"HEAD / HTTP/1.0\r\n\r\n")
                        banner = sock.recv(64).decode('utf-8', errors='ignore').strip().replace("\n", " ")
                    except Exception:
                        pass
                    sock.close()
                    return {"port": port, "service": service_name, "banner": banner[:30] if banner else "No Banner"}
                sock.close()
            except Exception:
                pass
            return None

        with concurrent.futures.ThreadPoolExecutor(max_workers=15) as executor:
            futures = [executor.submit(probe_port, p, s) for p, s in critical_ports.items()]
            for future in concurrent.futures.as_completed(futures):
                result = future.result()
                if result:
                    open_services.append(result)

        # High-risk open ports penalty
        risky_ports = [21, 23, 445, 1433, 3306, 3389, 6379, 27017]
        for s in open_services:
            if s["port"] in risky_ports:
                self.risk_score += 1.5
                self.risk_factors.append(f"Exposed Risky Database/Service Port: {s['port']} ({s['service']})")
            else:
                self.risk_score += 0.2

        self.data["ports"] = sorted(open_services, key=lambda x: x["port"])

    def run_all(self):
        """Executes full multi-threaded OSINT sweep."""
        console.print(Panel.fit(
            f"[bold white style=on red] ERSEC v3.0 — ULTIMATE OSINT & THREAT ENGINE [/]\n"
            f"[bold cyan]TARGET Domain:[/] {self.target}",
            border_style="red"
        ))

        self.resolve_dns()

        with Progress(SpinnerColumn(), TextColumn("[progress.description]{task.description}"), transient=True) as progress:
            progress.add_task(description=f"Gathering Deep Threat Intelligence on {self.target}...", total=None)
            
            with concurrent.futures.ThreadPoolExecutor() as executor:
                executor.submit(self.fetch_geoip)
                executor.submit(self.fetch_rdap_whois)
                executor.submit(self.audit_http_headers)
                executor.submit(self.inspect_ssl_tls)
                executor.submit(self.enumerate_subdomains)
                executor.submit(self.check_robots_txt)
                executor.submit(self.scan_ports_and_banners)

        self.render_dashboard()

    def render_dashboard(self):
        """Renders rich executive visual dashboard."""
        
        # 1. RISK SCORE BADGE
        final_score = round(min(self.risk_score, 10.0), 1)
        if final_score >= 7.0:
            color, rating = "bold red", "CRITICAL THREAT LEVEL"
        elif final_score >= 3.5:
            color, rating = "bold yellow", "MODERATE RISK LEVEL"
        else:
            color, rating = "bold green", "LOW RISK / SECURE"

        console.print(Panel(
            f"[{color}]THREAT SCORE: {final_score} / 10.0  —  [{rating}][/{color}]",
            border_style=color.split()[-1],
            title="[bold]Calculated Attack Surface Risk[/bold]"
        ))

        # 2. INFRASTRUCTURE & DOMAIN INTEL
        tree = Tree(f"[bold red]Target Infrastructure: {self.target}[/bold red]")
        
        # IP Branch
        ip_branch = tree.add(f"[bold yellow]DNS & Network Routing[/bold yellow]")
        for ip in self.data.get("ips", []):
            ip_branch.add(f"Resolved IP: [white]{ip}[/white]")
        
        # GeoIP Branch
        geo = self.data.get("geoip")
        if geo:
            geo_branch = tree.add("[bold yellow]Geolocation & ASN[/bold yellow]")
            geo_branch.add(f"Country/City: {geo.get('country')}, {geo.get('city')}")
            geo_branch.add(f"ISP: {geo.get('isp')}")
            geo_branch.add(f"ASN: {geo.get('as')}")

        # RDAP Branch
        rdap = self.data.get("rdap")
        if rdap:
            rdap_branch = tree.add("[bold yellow]Domain WHOIS / RDAP[/bold yellow]")
            rdap_branch.add(f"Registrar: {rdap.get('registrar')}")
            rdap_branch.add(f"Created Date: {rdap.get('created')}")
            rdap_branch.add(f"Expiration: {rdap.get('expiration')}")

        console.print(Panel(tree, border_style="cyan", title="[bold]Core Intelligence Summary[/bold]"))

        # 3. HTTP SECURITY HEADERS & SERVER
        http_d = self.data.get("http")
        if http_d:
            table_hdr = Table(title="HTTP Security Header Audit", expand=True)
            table_hdr.add_column("Protection Policy", style="cyan")
            table_hdr.add_column("Audit Result", style="bold")

            for label, val in http_d["present"].items():
                table_hdr.add_row(label, f"[green]✓ PASS ({val})[/green]")
            for label in http_d["missing"]:
                table_hdr.add_row(label, "[red]✗ MISSING (Vulnerable)[/red]")

            console.print(table_hdr)

        # 4. SSL CERTIFICATE & SUBDOMAINS
        ssl_d = self.data.get("ssl")
        subs = self.data.get("subdomains", [])
        
        sub_panel_text = f"[bold yellow]Discovered Subdomains ({len(subs)} Total):[/bold yellow]\n"
        if subs:
            sub_panel_text += "\n".join([f" • [white]{s}[/white]" for s in subs[:10]])
            if len(subs) > 10:
                sub_panel_text += f"\n [dim]... and {len(subs) - 10} more found[/dim]"
        else:
            sub_panel_text += " [dim]No public SAN subdomains found.[/dim]"

        if ssl_d and "error" not in ssl_d:
            sub_panel_text += f"\n\n[bold yellow]SSL Issuer:[bold yellow] {ssl_d.get('issuer')}\n[bold yellow]Certificate Expiration:[bold yellow] {ssl_d.get('valid_until')}"

        console.print(Panel(sub_panel_text, border_style="magenta", title="[bold]Subdomain & Certificate Footprint[/bold]"))

        # 5. OPEN PORTS TABLE
        ports = self.data.get("ports", [])
        table_ports = Table(title="Port Scan & Banner Grabbing", expand=True)
        table_ports.add_column("Port", style="bold yellow")
        table_ports.add_column("Service Name", style="cyan")
        table_ports.add_column("Response Banner / Fingerprint", style="bold white")

        if ports:
            for p in ports:
                table_ports.add_row(str(p["port"]), p["service"], p["banner"])
            console.print(table_ports)
        else:
            console.print("[green][+] No open or filtered critical ports detected.[/green]\n")

        # 6. RISK FACTORS BREAKDOWN
        if self.risk_factors:
            console.print("[bold red]Identified Attack Surface Vulnerabilities:[/bold red]")
            for factor in self.risk_factors:
                console.print(f" [red]•[/red] [yellow]{factor}[/yellow]")
            console.print("")

if __name__ == "__main__":
    if len(sys.argv) < 3 or sys.argv[1] != "scan":
        console.print("[bold red]Usage:[/bold red] ersec scan <domain.com>")
        sys.exit(1)

    target_domain = sys.argv[2]
    engine = ErsecEngine(target_domain)
    engine.run_all()
