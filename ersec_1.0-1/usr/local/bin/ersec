#!/usr/bin/env python3
import concurrent.futures
import json
import os
import socket
import ssl
import sys
import requests
from rich.console import Console
from rich.panel import Panel
from rich.progress import Progress, SpinnerColumn, TextColumn
from rich.table import Table
from rich.tree import Tree

console = Console()

class ErsecEngine:
    def __init__(self, target):
        self.target = target.replace("https://", "").replace("http://", "").strip("/")
        self.ip = None
        self.ips = []
        self.risk_score = 0.0
        self.risk_factors = []
        self.data = {}

    def resolve_dns(self):
        try:
            _, _, ips = socket.gethostbyname_ex(self.target)
            self.ips = ips
            self.ip = ips[0]
            self.data["ips"] = ips
        except Exception as e:
            console.print(f"[bold red][!] DNS Resolution failed for {self.target}: {e}[/bold red]")
            sys.exit(1)

    def fetch_geoip(self):
        try:
            res = requests.get(f"http://ip-api.com/json/{self.ip}?fields=status,country,regionName,city,isp,org,as,query", timeout=5).json()
            self.data["geoip"] = res if res.get("status") == "success" else None
        except Exception:
            self.data["geoip"] = None

    def fetch_rdap_whois(self):
        try:
            res = requests.get(f"https://rdap.org/domain/{self.target}", timeout=6).json()
            events = {e.get("eventAction"): e.get("eventDate", "N/A")[:10] for e in res.get("events", [])}
            self.data["rdap"] = {
                "registrar": res.get("port43", "N/A"),
                "created": events.get("registration", "N/A"),
                "expiration": events.get("expiration", "N/A"),
            }
        except Exception:
            self.data["rdap"] = None

    def audit_http_headers(self):
        headers_info = {"present": {}, "missing": []}
        try:
            res = requests.get(f"http://{self.target}", timeout=6, allow_redirects=True)
            headers = res.headers

            sec_headers = {
                "Strict-Transport-Security": "HSTS Enforced",
                "Content-Security-Policy": "CSP Configured",
                "X-Frame-Options": "Clickjacking Protection",
                "X-Content-Type-Options": "MIME Sniffing Protection"
            }

            for header, label in sec_headers.items():
                if header in headers:
                    headers_info["present"][label] = headers[header][:30]
                else:
                    headers_info["missing"].append(label)
                    self.risk_score += 0.5
                    self.risk_factors.append(f"Missing Header: {header}")

            self.data["http"] = headers_info
        except Exception:
        open_services = []

        def probe(port, name):
            try:
                sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
                sock.settimeout(1.0)
                sock.close()
            except Exception:
                pass
            return None

        with concurrent.futures.ThreadPoolExecutor(max_workers=10) as executor:
            futures = [executor.submit(probe, p, s) for p, s in critical_ports.items()]
            for f in concurrent.futures.as_completed(futures):
                res = f.result()
                if res:
                    open_services.append(res)
                    if res["port"] in [21, 3306, 3389]:
                        self.risk_score += 2.0
                        self.risk_factors.append(f"Exposed Risky Service: {res['service']} ({res['port']})")

        self.data["ports"] = open_services

    def query_groq_executive_ai(self):

        models_to_try = [
            "llama-3.3-70b-versatile",
            "llama-3.1-70b-versatile",
            "llama3-70b-8192",
            "mixtral-8x7b-32768"
        ]

        prompt = f"""
        Target: {self.target}
        Risk Score: {self.risk_score}/10
        Identified Vulnerabilities: {json.dumps(self.risk_factors)}
        Open Ports: {json.dumps(self.data.get('ports', []))}

        As a CISO Threat Analyst, provide:
        1. Executive Threat Summary (2 sentences max).
        2. Top 2 Attack Vectors an adversary would exploit.
        3. Immediate Remediation Priority.
        Keep output concise and impact-focused.
        """

        headers = {"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"}

        for model in models_to_try:
            try:
                res = requests.post(
                    "https://api.groq.com/openai/v1/chat/completions",
                    headers=headers,
                    json={"model": model, "messages": [{"role": "user", "content": prompt}], "temperature": 0.2},
                    timeout=8
                )
                if res.status_code == 200:
                    return f"[bold green]Model Used: {model}[/bold green]\n\n" + res.json()['choices'][0]['message']['content']
            except Exception:
                continue

        return "[red]Failed to reach Groq API across all candidate models.[/red]"

    def run_all(self):
        console.print(Panel.fit(
            f"[bold white style=on red] ERSEC v4.0 — REVOLUTIONARY AI OSINT & THREAT ENGINE [/]\n"
            f"[bold cyan]Target:[/] {self.target}",
            border_style="red"
        ))

        self.resolve_dns()

        with Progress(SpinnerColumn(), TextColumn("[progress.description]{task.description}"), transient=True) as progress:
            progress.add_task(description="Running Threat Intelligence Sweep...", total=None)
            with concurrent.futures.ThreadPoolExecutor() as executor:
                executor.submit(self.fetch_geoip)
                executor.submit(self.fetch_rdap_whois)
                executor.submit(self.audit_http_headers)
                executor.submit(self.scan_ports)

        score = min(self.risk_score, 10.0)
        console.print(Panel(f"THREAT SCORE: {score}/10.0", border_style="red" if score > 4 else "green"))

        ai_summary = self.query_groq_executive_ai()
        console.print(Panel(ai_summary, title="[bold cyan]Groq AI Executive Threat Analysis[/bold cyan]", border_style="cyan"))

if __name__ == "__main__":
    if len(sys.argv) < 3 or sys.argv[1] != "scan":
        console.print("[bold red]Usage:[/bold red] ersec scan <domain.com>")
        sys.exit(1)

    engine = ErsecEngine(sys.argv[2])
    engine.run_all()        api_key = os.getenv("GROQ_API_KEY")
        if not api_key:
            return "[yellow]GROQ_API_KEY environment variable not set. Skipping AI synthesis.[/yellow]"
